# IMPORTANT: URL-encode special characters in the password.
# Common offenders: # → %23  @  → %40  : → %3A  / → %2F
# Example: password YukinoHana#730 must be written as YukinoHana%23730
# Unescaped # truncates the URL at the fragment separator → EAI_AGAIN at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/website_master_platform?schema=public"
DATABASE_POOL_MAX="20"
DATABASE_POOL_IDLE_TIMEOUT_MS="30000"
DATABASE_POOL_CONNECT_TIMEOUT_MS="10000"

# NextAuth
# Local development may override NEXTAUTH_URL to http://localhost:4000.
# Production WMP has one canonical origin: https://wmp.dagangos.com
NEXTAUTH_URL="https://wmp.dagangos.com"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"
ENCRYPTION_KEY="replace-with-a-strong-secret"
# Comma-separated addresses of reverse proxies allowed to supply x-forwarded-for.
# Loopback is trusted automatically for same-host Nginx -> WMP deployments.
TRUSTED_PROXY_IPS=""
# Enable only when the origin cannot be reached without the trusted proxy.
TRUST_PROXY_HEADERS="false"
TRUST_CLOUDFLARE_IP_HEADER="false"

# JWT
JWT_SECRET="your-jwt-secret-key"
JWT_REFRESH_SECRET="your-refresh-secret-key"

# App
NEXT_PUBLIC_APP_URL="https://wmp.dagangos.com"
NEXT_PUBLIC_APP_NAME="Website Master Platform"
NEXT_PUBLIC_BASE_DOMAIN="wmp.dagangos.com"

# store.dagangos.com and shop.dagangos.com are reserved for other products.
# Do not point or redirect either hostname to WMP.

# File Storage (AWS S3 or compatible)
STORAGE_BUCKET="your-bucket-name"
STORAGE_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"

# Payment Gateways (optional)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# AI (optional)
OPENAI_API_KEY="sk-..."

# Email (SendGrid / SES)
SENDGRID_API_KEY="SG...."
EMAIL_FROM="noreply@yourplatform.com"

# SMS (Twilio)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."

# Control-plane and generic webhook authentication
CONTROL_PLANE_SECRET="replace-with-a-strong-control-plane-secret"
WEBHOOK_API_KEY="replace-with-a-strong-webhook-key"

# Provider webhook verification (configure only enabled providers)
XENDIT_WEBHOOK_TOKEN=""
MIDTRANS_SERVER_KEY=""
